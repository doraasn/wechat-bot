[Unit]
Description=Weixin ClawBot Bridge
Requires=wechat-mimocode-bot.service
After=network-online.target wechat-mimocode-bot.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
WorkingDirectory=/data/projects/wechat-bot
Environment=HOME=/root
Environment=PATH=/root/.bun/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WEIXIN_CLAWBOT_BRIDGE_STATE_DIR=/data/projects/wechat-bot/data/weixin-clawbot-bridge
ExecStart=/usr/local/bin/bun run node_modules/weixin-clawbot-bridge/src/cli/index.ts start --adapter webhook --endpoint http://127.0.0.1:3000/webhook --port 3200
Restart=always
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

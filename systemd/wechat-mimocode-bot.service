[Unit]
Description=WeChat MiMoCode Bot
Requires=mimocode-server.service
After=network-online.target tailscaled.service docker.service mimocode-server.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
WorkingDirectory=/data/projects/wechat-bot
Environment=HOME=/root
Environment=PATH=/root/.bun/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MIMO_SERVER_URL=http://127.0.0.1:4096
Environment=WECHAT_ILINK_STATE_DIR=/data/projects/wechat-bot/data/ilink
ExecStart=/usr/local/bin/bun run bot-handler.ts
Restart=always
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
